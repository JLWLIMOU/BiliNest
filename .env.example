# BiliNest 环境变量示例
# 使用方法（Node 20.6+）：复制本文件为 .env 并填写，然后运行
#   node --env-file=.env server.mjs
# 或使用系统环境变量（例如 PowerShell：$env:BILINEST_PORT = 4173）

# 监听端口（默认 4173）
BILINEST_PORT=4173

# 监听地址（默认仅本机 127.0.0.1，更安全；不要改成 0.0.0.0）
BILINEST_HOST=127.0.0.1

# ---- 可选：B 站开放平台 OAuth（需要先在 https://open.bilibili.com 注册应用）----
# 申请应用后获得 client_id / client_secret。
# 开放平台要求填写「授权回调域」，需与下方 BILINEST_OAUTH_REDIRECT_URI 的域名端口一致。
# 不配置时，应用仅支持 SESSDATA/Cookie 方式登录。
BILINEST_OAUTH_CLIENT_ID=
BILINEST_OAUTH_CLIENT_SECRET=
BILINEST_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/api/oauth/callback
